# Copie este arquivo para .env e preencha com a URL de conexão do seu banco Postgres (ex: Railway).
DATABASE_URL="postgresql://usuario:senha@host:5432/notic_ia?schema=public"

# Segredo usado pelo NextAuth para assinar sessões/JWT. Gere um novo com: openssl rand -base64 32
NEXTAUTH_SECRET="gere-um-valor-aleatorio-aqui"
# URL base da aplicação (em produção na Vercel, use a URL pública do deploy)
NEXTAUTH_URL="http://localhost:3000"
