// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PRO
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  nome           String
  senha          String
  dataNascimento DateTime
  areaAtuacao    String
  plano          Plan     @default(FREE)
  createdAt      DateTime @default(now())

  temas        UserTheme[]
  chatMessages ChatMessage[]
  readLaters   ReadLater[]
  favorites    Favorite[]

  conexoesEnviadas  Connection[] @relation("ConexoesEnviadas")
  conexoesRecebidas Connection[] @relation("ConexoesRecebidas")
  noticiasEnviadas  SharedNews[] @relation("NoticiasEnviadas")
  noticiasRecebidas SharedNews[] @relation("NoticiasRecebidas")

  @@map("users")
}

model Theme {
  id   String @id @default(cuid())
  nome String @unique

  usuarios UserTheme[]
  noticias News[]

  @@map("themes")
}

model UserTheme {
  id      String @id @default(cuid())
  userId  String
  themeId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([userId, themeId])
  @@map("user_themes")
}

model News {
  id             String   @id @default(cuid())
  titulo         String
  resumoIA       String   @db.Text
  linkFonte      String
  nomeFonte      String
  dataPublicacao DateTime
  createdAt      DateTime @default(now())

  themeId String
  tema    Theme @relation(fields: [themeId], references: [id])

  chatMessages ChatMessage[]
  readLaters   ReadLater[]
  favorites    Favorite[]
  sharedNews   SharedNews[]

  @@map("news")
}

model ReadLater {
  id        String   @id @default(cuid())
  userId    String
  newsId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([userId, newsId])
  @@map("read_later")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  newsId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([userId, newsId])
  @@map("favorites")
}

model Connection {
  id          String           @id @default(cuid())
  requesterId String
  receiverId  String
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  requester User @relation("ConexoesEnviadas", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver  User @relation("ConexoesRecebidas", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@map("connections")
}

model SharedNews {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  newsId     String
  message    String?  @db.Text
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("NoticiasEnviadas", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("NoticiasRecebidas", fields: [receiverId], references: [id], onDelete: Cascade)
  news     News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@map("shared_news")
}

model ChatMessage {
  id        String   @id @default(cuid())
  pergunta  String   @db.Text
  resposta  String   @db.Text
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  newsId String
  news   News   @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}
